{
  "name": "tablekeeper-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:invariants": "vitest run tests/invariants.test.ts tests/soak.test.ts",
    "test:all": "vitest run",
    "db:migrate": "tsx src/lib/db/migrate-cli.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx src/lib/db/migrate-cli.ts --reset",
    "attack": "node scripts/attack.mjs",
    "redteam": "node scripts/redteam.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "next": "^16.1.1",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
